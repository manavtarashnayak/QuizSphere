# PostgreSQL database used by the FastAPI backend
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/quiz_platform

# Generate a unique random value for every environment. Do not commit .env.
SECRET_KEY=replace_with_a_secure_random_secret_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated frontend origins allowed during development.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
